# ===================================================================
# Vanga - Environment Configuration
# ===================================================================
# Phase 0 has no runtime env vars (static site + WebRTC LAN only).
# This file is scaffolding for later phases.

# === Phase 1+ (Noise NK + optional signaling relay) ===

# Optional ephemeral signaling relay endpoint (ws:// or wss://)
# Leave empty to use QR-only signaling (two-QR flow)
# VANGA_SIGNALING_URL=

# === Phase 2+ (Go relay / discovery) ===

# Public STUN server(s) for NAT traversal, comma-separated
# VANGA_STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478

# Self-hosted TURN relay (fallback when STUN fails)
# VANGA_TURN_URL=
# VANGA_TURN_USERNAME=
# VANGA_TURN_CREDENTIAL=

# Self-hosted discovery server (Go, Phase 2)
# VANGA_DISCOVERY_URL=

# === Dev tooling ===

# Enable verbose debug logging in the browser (never in prod)
# VANGA_DEBUG=false
