# --- Standard project .gitignore template ---
# Copy to `.gitignore` at repo root and tailor for the stack.

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
yarn.lock

# Build outputs
dist/
build/
target/
*.tsbuildinfo
*.wasm

# Go (if applicable)
*.exe
*.test
*.out
native/bin/

# Environment
.env
.env.*
!.env.example

# IDE / OS
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Testing
coverage/
.nyc_output/

# Logs / temp
logs/
*.log
tmp/
temp/
*.tmp

# Security reference (compromised packages list, locally tracked)
COMPROMISED_PACKAGES.txt
.pnpm-store/

# Private workspace — gitignored entirely. Promote artefacts into
# docs/decisions/, docs/plans/, or docs/ARCHITECTURE.md.
private/*
.private/*
!private/.gitkeep
!.private/.gitkeep
